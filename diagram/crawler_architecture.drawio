        </mxCell>
        <mxCell id="cprog" value='&lt;b&gt;&lt;font color="#2b4c7e" style="font-size:15px"&gt;search.py — TF-IDF cosine ranking&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;idf: classic · smooth · max&lt;/font&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;&lt;font face="Menlo, Courier New, monospace"&gt;+term  -term  -prefix*  nutri:a  sugars&amp;lt;5&lt;/font&gt;&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#eef3fb;strokeColor=#4a6fa5;strokeWidth=1.5;" vertex="1" parent="1">
