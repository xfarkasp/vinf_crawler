          <mxGeometry x="30" y="800" width="1010" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="p2t" value="STEP 2 — run separately, any time (no downloading)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=18;fontColor=#5b3f8c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="812" width="700" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="ain" value='&lt;b&gt;&lt;font color="#1f2937" style="font-size:13.5px"&gt;&lt;font face="Menlo, Courier New, monospace"&gt;html/products/**&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:13px"&gt;saved product pages&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5a9e6f;strokeWidth=1.5;" vertex="1" parent="1">
