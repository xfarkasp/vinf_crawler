        <mxCell id="file3" value='&lt;b&gt;&lt;font color="#1f2937" style="font-size:14px"&gt;&lt;font face="Menlo, Courier New, monospace"&gt;visited_urls.txt&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:13px"&gt;finished URLs → resume after a restart&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5a9e6f;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1100" y="610" width="420" height="80" as="geometry"/>
