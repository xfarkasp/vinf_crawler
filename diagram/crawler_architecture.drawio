        </mxCell>
        <mxCell id="bprog" value='&lt;b&gt;&lt;font color="#2b4c7e" style="font-size:15px"&gt;indexer.py — own inverted index&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;tokenize · stop words · term frequency (TF)&lt;/font&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;term → postings doc:tf · vector lengths per idf&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#eef3fb;strokeColor=#4a6fa5;strokeWidth=1.5;" vertex="1" parent="1">
