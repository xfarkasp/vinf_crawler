        <mxCell id="cin" value="&lt;b&gt;&lt;font color=&quot;#1f2937&quot; style=&quot;font-size:13.5px&quot;&gt;&lt;font face=&quot;Menlo, Courier New, monospace&quot;&gt;index/index.json&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot; style=&quot;font-size:13px&quot;&gt;+ the user's query&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#5b3f8c;strokeWidth=1.5;" vertex="1" parent="1">
