        <mxCell id="aprog" value='&lt;b&gt;&lt;font color="#8e2f5a" style="font-size:15px"&gt;extractor.py — regex only&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;name, brands, categories, countries, scores,&lt;/font&gt;&lt;br&gt;&lt;font color="#4b5563" style="font-size:12.5px"&gt;ingredients, additives, allergens, nutrition&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fdf1f6;strokeColor=#c25b86;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="360" y="848" width="400" height="70" as="geometry"/>
